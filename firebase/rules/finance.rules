// ---------------------------------------------------------------------------
// Argent : paiements, remboursements, grand livre, reversements, factures,
// déclarations, formules, abonnements, barèmes de commission.
// Tous les mouvements sont écrits par Cloud Functions (Stripe, planificateurs).
// ---------------------------------------------------------------------------

match /payments/{paymentId} {
  allow read: if (resource.data.payerType == 'client' && isSelf(resource.data.payerId))
    || (resource.data.get('restaurantId', null) != null
      && resource.data.purpose != 'order'
      && can(resource.data.restaurantId, 'finance.view'))
    || isAdminIn('payments.view', resource.data.cityId);
  allow write: if false;
}

match /refunds/{refundId} {
  // `refunds.create` (seule permission de ce rôle) doit être bornée par ville : un
  // `city_manager` limité à une ville (qui a `refunds.create` mais ni `refunds.approve` ni
  // `finance.view`) pouvait sinon lire directement tous les remboursements de la plateforme,
  // contournant le périmètre déjà appliqué côté Cloud Function (`loadTicketFor`).
  allow read: if isSelf(resource.data.customerId)
    || can(resource.data.restaurantId, 'finance.view')
    || isAdminIn('refunds.create', resource.data.cityId)
    || isAdminIn('finance.view', resource.data.cityId);
  allow write: if false;
}

match /ledgerEntries/{entryId} {
  allow read: if (resource.data.accountType == 'restaurant' && can(resource.data.accountId, 'finance.view'))
    || (resource.data.accountType in ['driver', 'driver_cash', 'customer_wallet'] && isSelf(resource.data.accountId))
    || isAdminIn('finance.view', resource.data.cityId);
  allow write: if false;
}

match /payouts/{payoutId} {
  allow read: if (resource.data.beneficiaryType == 'restaurant' && can(resource.data.beneficiaryId, 'finance.view'))
    || (resource.data.beneficiaryType == 'driver' && isSelf(resource.data.beneficiaryId))
    || isAdminIn('finance.view', resource.data.cityId);
  allow write: if false;
}

match /payoutHolds/{holdId} {
  // `cityId` écrit par `holdPayouts`/`unpaid_subscription` mais absent de certains documents
  // très anciens : `get(..., null)` renvoie alors « non couvert » pour un admin restreint
  // (refus par défaut), jamais une fuite.
  allow read: if isAdminIn('finance.view', resource.data.get('cityId', null));
  allow write: if false;
}

// Factures et avoirs : jamais modifiés ni supprimés après émission.
match /invoices/{invoiceId} {
  allow read: if (resource.data.recipient.type == 'restaurant' && can(resource.data.recipient.id, 'invoices.view'))
    || (resource.data.recipient.type in ['client', 'driver'] && isSelf(resource.data.recipient.id))
    || (resource.data.issuer.type == 'driver' && isSelf(resource.data.issuer.id))
    || isAdminIn('invoices.view', resource.data.cityId);
  allow write: if false;
}

match /taxReports/{reportId} {
  // Déclaration scopée par PAYS (pas de ville) : isAdminInCountry, pas isAdminIn.
  allow read: if isAdminInCountry('tax.reports', resource.data.countryId);
  allow write: if false;
}

match /plans/{planCode} {
  allow read: if true;
  // Écriture : updatePlan (Cloud Function, motif, audit).
  allow write: if false;
}

// Changement de formule, essai, résiliation, impayés : Cloud Functions (Stripe Billing).
match /subscriptions/{subscriptionId} {
  allow read: if (resource.data.subscriberType == 'restaurant' && can(resource.data.subscriberId, 'finance.view'))
    || isAdminIn('subscriptions.manage', resource.data.cityId)
    || isAdminIn('finance.view', resource.data.cityId);
  allow write: if false;
}

// Barèmes versionnés : une modification crée une nouvelle règle, l'ancienne est close par trigger.
// Scopés par PAYS (pas de ville) : isAdminInCountry, pas isAdminIn.
match /commissionRules/{ruleId} {
  allow read: if isAdminInCountry('commissions.edit', resource.data.countryId)
    || isAdminInCountry('finance.view', resource.data.countryId)
    || isAdminInCountry('restaurants.commercial', resource.data.countryId);
  // Création d'un barème : updateCommissionRule (Cloud Function : clôture de l'ancien, motif, audit).
  allow write: if false;
}

// Prestataires de paiement par pays (Stripe, prestataires locaux) : lisibles par tout compte connecté
// (choix du compte de paiement dans les apps), modifiés par Cloud Function uniquement.
match /paymentProviders/{providerId} {
  allow read: if signedIn();
  allow write: if false;
}

// Espèces des livreurs salariés du commerce : suivi de la caisse et remises, écrit par Cloud Function.
match /cashMovements/{movementId} {
  allow read: if can(resource.data.restaurantId, 'couriers.manage')
    || can(resource.data.restaurantId, 'finance.view')
    || isAdminIn('finance.view', resource.data.get('cityId', null));
  allow write: if false;
}

// Codes de parrainage : recherchés par Cloud Function uniquement.
match /referralCodes/{code} {
  allow read, write: if false;
}
