// ---------------------------------------------------------------------------
// Exploitation du super admin (livreurs, commandes, règles, zones) : droits de
// lecture complémentaires. Toutes les écritures passent par Cloud Functions
// (functions/src/admin/operations) ; ces blocs s'ajoutent (OU logique) à ceux
// des autres domaines pour les mêmes chemins.
// ---------------------------------------------------------------------------

// Historique d'une fiche livreur ou commande, et des zones et villes : lisible par
// les administrateurs qui gèrent ces éléments, dans leur périmètre.
match /auditLogs/{logId} {
  allow read: if (resource.data.target.type == 'driver' && isAdminIn('drivers.view', resource.data.cityId))
    || (resource.data.target.type == 'order' && isAdminIn('orders.view', resource.data.cityId))
    || (resource.data.target.type in ['zone', 'city'] && isAdminIn('zones.edit', resource.data.cityId));
}

// Historique des réglages d'exploitation (règles des commandes, attribution,
// rémunération, zones) : lisible par ceux qui peuvent les modifier. Une entrée scopée à une
// ville (`cityId` posé par `writeSettingsHistory`) borne la lecture à cette ville — sans ça, un
// admin `city_manager` limité à une ville (qui a `zones.edit` par défaut) pouvait lire
// l'historique des réglages (avant/après, motif) de n'importe quelle autre ville. Une entrée
// sans ville (réglage plateforme/pays) reste lisible par simple détention de la permission,
// comme avant.
match /settingsHistory/{entryId} {
  allow read: if (resource.data.get('cityId', null) == null
      && (isAdmin('order_rules.edit') || isAdmin('zones.edit') || isAdmin('drivers.pay_rules')))
    || (resource.data.get('cityId', null) != null
      && (isAdminIn('order_rules.edit', resource.data.cityId) || isAdminIn('zones.edit', resource.data.cityId) || isAdminIn('drivers.pay_rules', resource.data.cityId)));
}
