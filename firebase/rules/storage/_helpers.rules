// ---------------------------------------------------------------------------
// Fonctions communes des règles Cloud Storage. Les droits sont lus dans
// Firestore (admins/{uid}, restaurants/{rid}/members/{uid}) via firestore.get.
// ---------------------------------------------------------------------------

function signedIn() {
  return request.auth != null;
}

function isSelf(userId) {
  return signedIn() && request.auth.uid == userId;
}

function role() {
  return signedIn() ? request.auth.token.get('role', '') : '';
}

function adminHas(a, perm) {
  return a.active == true && (a.role == 'super_admin' || perm in a.permissions);
}

function isAdmin(perm) {
  return role() == 'admin'
    && adminHas(firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data, perm);
}

// Équivalent de isAdminIn côté règles Firestore (firebase/rules/_helpers.rules) : un admin
// restreint par ville (cityIds non vide sur sa fiche, posable sur n'importe quel rôle, pas
// seulement city_manager) ne doit accéder qu'aux fichiers des villes couvertes par son mandat.
function adminCovers(a, cityId) {
  return a.cityIds.size() == 0 || cityId in a.cityIds;
}

function isAdminIn(perm, cityId) {
  return role() == 'admin'
    && adminCovers(firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data, cityId)
    && adminHas(firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data, perm);
}

function memberHas(m, perm) {
  return m.active == true && (m.role == 'owner' || perm in m.permissions);
}

function can(rid, perm) {
  return signedIn()
    && firestore.exists(/databases/(default)/documents/restaurants/$(rid)/members/$(request.auth.uid))
    && memberHas(firestore.get(/databases/(default)/documents/restaurants/$(rid)/members/$(request.auth.uid)).data, perm);
}

function isImage(maxMb) {
  return request.resource.contentType.matches('image/(jpeg|png|webp|avif)')
    && request.resource.size <= maxMb * 1024 * 1024;
}

function isDocument(maxMb) {
  return request.resource.contentType.matches('image/(jpeg|png|webp|heic)|application/pdf')
    && request.resource.size <= maxMb * 1024 * 1024;
}
